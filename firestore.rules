rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.admin == true ||
         request.auth.token.email == 'singhm38578@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasServerSecret() {
      return request.resource.data.serverSecret == 'creatornova_backend_sec_key_2026';
    }

    // User profile document: users/{uid}
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      // Client cannot modify creditBalance, plan, credits, or creditResetDate directly
      // Only server-authorized requests with serverSecret or admin can change wallet balance
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() ||
        hasServerSecret() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creditBalance', 'plan', 'creditResetDate', 'credits', 'role'])
      );
      allow delete: if isAdmin();

      // User Projects subcollection: users/{userId}/projects/{projectId}
      match /projects/{projectId} {
        allow read, write: if isOwner(userId) && isValidId(projectId);
      }

      // User Agent Plans subcollection: users/{userId}/agentPlans/{planId}
      match /agentPlans/{planId} {
        allow read, write: if isOwner(userId) && isValidId(planId);
      }

      // User Agent Tasks subcollection: users/{userId}/agentTasks/{taskId}
      match /agentTasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      // User Content Calendar subcollection: users/{userId}/calendar/{calendarId}
      match /calendar/{calendarId} {
        allow read, write: if isOwner(userId) && isValidId(calendarId);
      }

      // User Series subcollection: users/{userId}/series/{seriesId}
      match /series/{seriesId} {
        allow read, write: if isOwner(userId) && isValidId(seriesId);
      }

      // User Characters Library subcollection: users/{userId}/characters/{characterId}
      match /characters/{characterId} {
        allow read, write: if isOwner(userId) && isValidId(characterId);
      }

      // User Brand Kits subcollection: users/{userId}/brandKits/{brandKitId}
      match /brandKits/{brandKitId} {
        allow read, write: if isOwner(userId) && isValidId(brandKitId);
      }

      // User Credit Transactions subcollection: users/{userId}/creditTransactions/{transactionId}
      // Users can only read their credit history; writes are restricted to server-side backend logic
      match /creditTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && hasServerSecret();
      }

      // User Subscriptions subcollection: users/{userId}/subscriptions/{subscriptionId}
      // Read-only for user; write restricted to server-side backend logic
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && hasServerSecret();
      }

      // User Payments & Invoices subcollection: users/{userId}/payments/{paymentId}
      // Read-only for user; write restricted to server-side backend logic
      match /payments/{paymentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if (isOwner(userId) || isAdmin()) && hasServerSecret();
      }

      // User Media Assets metadata: users/{userId}/media/{mediaId}
      match /media/{mediaId} {
        allow read, write: if isOwner(userId) && isValidId(mediaId);
      }
    }

    // Platform global configs: readable by authenticated users, writable only by admins
    match /platformConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Public Templates: readable by anyone, writable by template creator or admin
    match /publicTemplates/{templateId} {
      allow get, list: if true;
      allow create: if isAuthenticated() && (request.resource.data.creatorUserId == request.auth.uid || hasServerSecret());
      allow update, delete: if isAuthenticated() && (resource.data.creatorUserId == request.auth.uid || isAdmin() || hasServerSecret());
    }

    // Referrals audit trail: readable by participants or admin; writable by authenticated or backend server
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (resource.data.referrerUserId == request.auth.uid || resource.data.referredUserId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() || hasServerSecret();
    }
  }
}

